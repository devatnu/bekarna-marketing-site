# Static-host headers (Cloudflare Pages / Netlify syntax). Files in public/ are
# copied verbatim into out/, so this lands at the deploy root automatically.

# Next's static export writes the OG card as an EXTENSIONLESS file named
# `opengraph-image`. A static host has nothing to infer a MIME type from and
# serves it as application/octet-stream — at which point WhatsApp, X and
# LinkedIn all refuse to render the preview, silently. Declare it explicitly.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Content-hashed assets never change under the same name — cache them forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should revalidate so a redeploy is picked up promptly.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers, matching the product app's posture.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
