# Static-host headers (Cloudflare Pages / Netlify syntax). Files in public/ are
# copied verbatim into out/, so this lands at the deploy root automatically.

# If an `opengraph-image` route is added back, it needs an explicit
# `Content-Type: image/png` rule here: the static export writes it as an
# EXTENSIONLESS file, a static host serves that as application/octet-stream, and
# WhatsApp, X and LinkedIn all silently refuse to render the preview.

# Content-hashed assets never change under the same name — cache them forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should revalidate so a redeploy is picked up promptly.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers, matching the product app's posture.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
